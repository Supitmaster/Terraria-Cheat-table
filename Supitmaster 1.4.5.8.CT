        <CheatEntry>
          <ID>10807</ID>
          <Description>"═══════════════════════════"</Description>
          <Options moAllowManualCollapseAndExpand="1"/>
          <Color>808080</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>139</ID>
          <Description>"═══ ⚔️ Combat &amp; Survival ═══"</Description>
          <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
          <Color>0096C8</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>140</ID>
              <Description>"God Mode"</Description>
              <Color>0096B4</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Forces Player.creativeGodMode = 1 at the per-frame reset. Journey godmode ignores all damage, lava, debuffs. }

[ENABLE]
aobscan(godReset, 88 96 1F 08 00 00)
alloc(newmem,64)
label(ret)

newmem:
  mov byte ptr [esi+0000081F],1
  jmp ret

godReset:
  jmp newmem
  nop
ret:

[DISABLE]
godReset:
  db 88 96 1F 08 00 00
dealloc(newmem)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>10828</ID>
              <Description>"Force Journey Mode"</Description>
              <Color>20C020</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Force Journey Mode: patches the local-player journey gate (get_LocalPlayer; cmp [player+7CB],3; je) from je to jmp, forcing the Journey code path regardless of character difficulty. Based on JOURNEY.md. Re-scans on enable (JIT-safe). }

[ENABLE]
{$lua}
if syntaxcheck then return end
_journeyAddrs={}
local scan=AOBScan('74 10 8B CE 33 D2')
if scan then
  for i=0,scan.Count-1 do
    local a=tonumber('0x'..scan[i])
    if a and readBytes(a-7,1,false)==0x80 and readBytes(a-6,1,false)==0xB8 and readBytes(a-5,1,false)==0xCB and readBytes(a-1,1,false)==0x03 then
      writeBytes(a,0xEB,0x10)
      table.insert(_journeyAddrs,a)
    end
  end
  scan.destroy()
end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if _journeyAddrs then for _,a in ipairs(_journeyAddrs) do writeBytes(a,0x74,0x10) end _journeyAddrs=nil end
{$asm}
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>10830</ID>
              <Description>"Research All (Journey - unlock duplication for all items)"</Description>
              <Color>20C020</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Research All (one-shot via RegisterItemSacrifice on game thread). ENABLE sets doResearch=1; the Main::Update hook loops itemId 1..researchMax calling RegisterItemSacrifice(tracker,id,999,999) then clears flag. esp-restore = convention-safe; tracker re-read each iter = GC-safe. }

[ENABLE]
alloc(cave,512)
alloc(doResearch,4)
alloc(researchMax,4)
alloc(savedEsp,4)
registersymbol(doResearch)
registersymbol(researchMax)
label(rdone) label(rloop) label(rskip) label(returnhere)

doResearch:
  dd 1
researchMax:
  dd #5500
savedEsp:
  dd 0

cave:
  pushad
  cmp dword [doResearch],0
  je rskip
  mov dword [doResearch],0
  mov esi,1
rloop:
  mov eax,[researchMax]
  cmp esi,eax
  jg rdone
  mov eax,[myPlayer]
  test eax,eax
  jz rdone
  mov eax,[eax+70]
  test eax,eax
  jz rdone
  mov eax,[eax+04]
  test eax,eax
  jz rdone
  mov [savedEsp],esp
  push #999
  push #999
  mov ecx,eax
  mov edx,esi
  call Terraria.GameContent.Creative.ItemsSacrificedUnlocksTracker::RegisterItemSacrifice
  mov esp,[savedEsp]
  inc esi
  jmp rloop
rdone:
rskip:
  popad
  push ebp
  mov ebp,esp
  push esi
  push eax
  jmp returnhere

Terraria.Main::Update:
  jmp cave
returnhere:

[DISABLE]
Terraria.Main::Update:
  db 55 8B EC 56 50
unregistersymbol(doResearch)
unregistersymbol(researchMax)
dealloc(savedEsp) dealloc(researchMax) dealloc(doResearch) dealloc(cave)
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>10839</ID>
              <Description>"Unlock All Journey"</Description>
              <Color>80FF00</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
alloc(cave,512)
alloc(doResearch,4)
alloc(researchMax,4)
alloc(savedEsp,4)
registersymbol(doResearch)
registersymbol(researchMax)
label(rdone) label(rloop) label(rskip) label(returnhere)

doResearch:
  dd 1
researchMax:
  dd #7000     // Upper bound high enough to cover all present &amp; future items
savedEsp:
  dd 0

cave:
  pushad
  cmp dword [doResearch],0
  je rskip
  mov dword [doResearch],0

  // 1. Check player pointer ONCE
  mov eax,[myPlayer]
  test eax,eax
  jz rskip

  // 2. Check CreativeTracker pointer (+0x70) ONCE
  mov eax,[eax+70]
  test eax,eax
  jz rskip

  // 3. Check ItemSacrificedUnlocksTracker pointer (+0x04) ONCE
  mov eax,[eax+04]
  test eax,eax
  jz rskip

  // Store tracker instance in EDI so it remains safe across iterations
  mov edi,eax

  mov esi,1    // Start at Item ID 1
rloop:
  mov eax,[researchMax]
  cmp esi,eax
  jg rdone

  // Preserve stack pointer before JIT internal method call
  mov [savedEsp],esp

  // Push arguments: RegisterItemSacrifice(trackerInstance, itemId, amount, amount)
  push #999     // amount to sacrifice (satisfies any item threshold)
  push #999     // duplicate amount parameter required by game method
  mov ecx,edi   // ECX = 'this' pointer (ItemSacrificedUnlocksTracker)
  mov edx,esi   // EDX = itemId (Passed in EDX via __fastcall / JIT convention)

  call Terraria.GameContent.Creative.ItemsSacrificedUnlocksTracker::RegisterItemSacrifice

  mov esp,[savedEsp] // Restore stack frame safely
  inc esi            // Move to next Item ID
  jmp rloop

rdone:
rskip:
  popad
  push ebp
  mov ebp,esp
  push esi
  push eax
  jmp returnhere

Terraria.Main::Update:
  jmp cave
returnhere:

[DISABLE]
Terraria.Main::Update:
  db 55 8B EC 56 50
unregistersymbol(doResearch)
unregistersymbol(researchMax)
dealloc(savedEsp)
dealloc(researchMax)
dealloc(doResearch)
dealloc(cave)
</AssemblerScript>
