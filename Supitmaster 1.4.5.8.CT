          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>10809</ID>
              <Description>"⛔ Debuff Removal"</Description>
              <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
              <Color>C08000</Color>
              <GroupHeader>1</GroupHeader>
              <CheatEntries>
                <CheatEntry>
                  <ID>10810</ID>
                  <Description>"No Mana Sickness (removes buff 94)"</Description>
                  <Color>C08000</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not debuffTimers then debuffTimers={} end
local function f()
  local p=readInteger("myPlayer"); if not p or p==0 then return end
  local aID=readInteger(p+0xC8); local aTm=readInteger(p+0xCC)
  if not aID or aID==0 or not aTm or aTm==0 then return end
  for i=0,43 do if readInteger(aID+8+i*4)==94 then writeInteger(aID+8+i*4,0); writeInteger(aTm+8+i*4,0) end end
end
local t=createTimer(nil,false); t.Interval=150; t.OnTimer=f; t.Enabled=true
debuffTimers["ManaSick"]=t
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if debuffTimers and debuffTimers["ManaSick"] then debuffTimers["ManaSick"].Enabled=false; debuffTimers["ManaSick"].destroy(); debuffTimers["ManaSick"]=nil end
{$asm}
</AssemblerScript>
                </CheatEntry>
