  <UserdefinedSymbols/>
  <LuaScript>-- ============================================================================
-- UI: Compact Mode + Creator Links + Auto Attach (by zey)
-- ============================================================================
function cycleFullCompact(sender, force)
  local form = getMainForm()
  local state = not (compactmenuitem.Caption == 'Compact View Mode')
  if force ~= nil then state = not force end
  compactmenuitem.Caption = state and 'Compact View Mode' or 'Full View Mode'
  form.Splitter1.Visible = state
  form.Panel4.Visible = state
  form.Panel5.Visible = state
end

function addCustomInterface()
  if customInterfaceAdded then return end
  local parent = getMainForm().Menu.Items

  local ucItem = createMenuItem(parent)
  parent.add(ucItem)
  ucItem.Caption = "UnknownCheats"
  ucItem.OnClick = function() shellExecute("https://www.unknowncheats.me/forum/members/2529642.html") end

  local flItem = createMenuItem(parent)
  parent.add(flItem)
  flItem.Caption = "FearLess"
  flItem.OnClick = function() shellExecute("https://fearlessrevolution.com/memberlist.php?mode=viewprofile&amp;u=252368") end

  compactmenuitem = createMenuItem(parent)
  parent.add(compactmenuitem)
  compactmenuitem.Caption = 'Compact View Mode'
  compactmenuitem.OnClick = cycleFullCompact

  customInterfaceAdded = true
end

function autoAttach()
  if getOpenedProcessID() == 0 then
    if getProcessIDFromProcessName("Terraria.exe") ~= 0 then
      openProcess("Terraria.exe")
      attachTimer.Enabled = false
    end
  else
    attachTimer.Enabled = false
  end
end

addCustomInterface()
cycleFullCompact(nil, true)

attachTimer = createTimer(getMainForm())
attachTimer.Interval = 1000
attachTimer.OnTimer = autoAttach
attachTimer.Enabled = true
</LuaScript>
</CheatTable>
