  local h=readInteger(ub+0xB8); local a=(h and h~=0) and readInteger(h) or 0
  if a and a~=0 then writeBytes(a+8+ID,(buffFreeze and buffFreeze[ID]) or 0); if buffFreeze then buffFreeze[ID]=nil end end
end
