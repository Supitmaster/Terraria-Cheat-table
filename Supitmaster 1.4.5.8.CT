alloc(inLoop,1)
registersymbol(killMult)
label(original)
label(extra_loop)
label(extra_done)

killMult:
  dd #10
inLoop:
  db 0

cave:
  cmp byte ptr [inLoop],0
  jne original
  mov byte ptr [inLoop],1
  push eax
  push ecx
  push edx
  push esi
  mov esi,ecx
  mov edx,[killMult]
  dec edx
extra_loop:
  test edx,edx
  jle extra_done
  push edx
  mov ecx,esi
  call Terraria.NPC::NPCLoot
  pop edx
  dec edx
  jmp extra_loop
extra_done:
  pop esi
  pop edx
  pop ecx
  pop eax
  mov byte ptr [inLoop],0
original:
