              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
_manaSubAddrs={}
local scan=AOBScan('74 06 29 BE 74 04 00 00 B8 01 00 00 00')
if scan then
  for i=0,scan.Count-1 do
    local a=tonumber('0x'..scan[i])+2
    writeBytes(a,0x90,0x90,0x90,0x90,0x90,0x90)
    table.insert(_manaSubAddrs,a)
  end
  scan.destroy()
end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if _manaSubAddrs then for _,a in ipairs(_manaSubAddrs) do writeBytes(a,0x29,0xBE,0x74,0x04,0x00,0x00) end _manaSubAddrs=nil end
{$asm}
</AssemblerScript>
