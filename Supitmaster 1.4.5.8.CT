label(SpawnRateRet) label(notDisable) label(noCap) label(storeCd) label(done)
registersymbol(SpawnRateAob SpawnRateOg)

SpawnRateOg:
  readmem(SpawnRateAob,7)

SpawnRateCode:
  push eax
  push edx
  mov eax,[spawnMult]
  cmp eax,#0
  jne notDisable
  mov dword [esi],#10000
  mov dword [edi],#0
  jmp done
notDisable:
  cmp eax,#1
  je done
  mov eax,[edi]
  imul eax,[spawnMult]
  cmp eax,#200
  jle noCap
  mov eax,#200
noCap:
  mov [edi],eax
  mov eax,[esi]
  xor edx,edx
  div dword [spawnMult]
  test eax,eax
  jnz storeCd
  mov eax,#1
storeCd:
  mov [esi],eax
done:
  pop edx
  pop eax
  readmem(SpawnRateAob,7)
  jmp SpawnRateRet

SpawnRateAob:
  jmp SpawnRateCode
  nop 2
SpawnRateRet:

