          <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
          <Color>0000FF</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>10836</ID>
              <Description>"Enable Minions Cheat"</Description>
              <Color>FF0080</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
// Hooking the minion cap initialization
aobscan(MINION_CAP_HOOK, C7 86 0C 03 00 00 01 00 00 00)
alloc(newmem,$1000,MINION_CAP_HOOK)

label(return)
label(minion_val)
registersymbol(minion_val)
registersymbol(MINION_CAP_HOOK)

newmem:
  // Write our custom value from minion_val instead of 1
  mov eax,[minion_val]
  mov [esi+0000030C],eax
  jmp return

minion_val:
  dd #100                 // Default: 100

MINION_CAP_HOOK:
  jmp newmem
  nop 5
return:

[DISABLE]
MINION_CAP_HOOK:
  // Restore original instruction: mov [esi+0000030C],00000001
  db C7 86 0C 03 00 00 01 00 00 00

unregistersymbol(MINION_CAP_HOOK)
unregistersymbol(minion_val)
dealloc(newmem)
</AssemblerScript>
