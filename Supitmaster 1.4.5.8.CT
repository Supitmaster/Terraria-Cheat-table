          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>137</ID>
          <Description>"═══ 🔨 Crafting &amp; World ═══"</Description>
          <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
          <Color>005AA0</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>138</ID>
              <Description>"Craft Anything (ignore station, materials, environment)"</Description>
              <Color>005AA0</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Craft Anything - NOPs the 3 requirement checks in Recipe::UpdateRecipeList }

[ENABLE]
Terraria.Recipe::UpdateRecipeList+FD:
  db 90 90
Terraria.Recipe::UpdateRecipeList+10E:
  db 90 90
Terraria.Recipe::UpdateRecipeList+11B:
  db 90 90

[DISABLE]
Terraria.Recipe::UpdateRecipeList+FD:
  db 74 26
Terraria.Recipe::UpdateRecipeList+10E:
  db 74 15
Terraria.Recipe::UpdateRecipeList+11B:
  db 7E 08
</AssemblerScript>
