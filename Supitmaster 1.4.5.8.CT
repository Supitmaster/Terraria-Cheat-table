            <CheatEntry>
              <ID>144</ID>
              <Description>"🚩 All Banners (+50% dmg, -25% dmg taken)"</Description>
              <Color>4080FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Injects at end of SceneMetrics.AggregateTileCounts (runs every frame): fills NPCBannerBuff all-true + hasBanner, so banner bonus applies to every enemy without any banner placed. }

[ENABLE]
aobscan(bannerEnd, 89 57 58 8B 47 38 2B 47 78 85 C0)
alloc(nm,256)
label(ret)
registersymbol(bannerEnd)

nm:
  pushfd
  push eax
  push ecx
  push edx
  mov eax,[edi+04]
  mov ecx,[eax+04]
  xor edx,edx
nmloop:
  mov byte ptr [eax+edx+08],1
  inc edx
  cmp edx,ecx
  jl nmloop
  mov byte ptr [edi+000000B1],1
  pop edx
  pop ecx
  pop eax
  popfd
  mov eax,[edi+38]
  sub eax,[edi+78]
  jmp ret

bannerEnd+3:
  jmp nm
  nop
ret:

[DISABLE]
bannerEnd+3:
  db 8B 47 38 2B 47 78
unregistersymbol(bannerEnd)
dealloc(nm)
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>10805</ID>
          <Description>"═══════════════════════════"</Description>
          <Options moAllowManualCollapseAndExpand="1"/>
          <Color>808080</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>135</ID>
          <Description>"═══ 🕊️ Movement ═══"</Description>
          <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
          <Color>C87800</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>136</ID>
              <Description>"Fly + Noclip (hold WASD/arrows; Space=up)"</Description>
              <Color>C87800</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not flyState then flyState={} end
flyState.speed = flyState.speed or 8
local function tick()
  local p=readInteger("myPlayer"); if not p or p==0 then return end
  local L=readBytes(p+0x7DF,1,false); local R=readBytes(p+0x7E0,1,false)
  local U=readBytes(p+0x7E1,1,false); local D=readBytes(p+0x7E2,1,false)
  local J=readBytes(p+0x7E3,1,false)
  local sp=flyState.speed
  local dx,dy=0,0
  if L==1 then dx=dx-sp end
  if R==1 then dx=dx+sp end
  if U==1 or J==1 then dy=dy-sp end
  if D==1 then dy=dy+sp end
  writeFloat(p+0x20, readFloat(p+0x20)+dx)
  writeFloat(p+0x24, readFloat(p+0x24)+dy)
  writeFloat(p+0x28, 0)
  writeFloat(p+0x2C, 0)
  writeBytes(p+0x94D, 1)
end
if flyState.timer then flyState.timer.destroy() end
local t=createTimer(nil,false); t.Interval=15; t.OnTimer=tick; t.Enabled=true
flyState.timer=t
-- auto-enable God if not already on
local al=getAddressList()
for i=0,al.Count-1 do local m=al.getMemoryRecord(i)
  if (m.Description or ""):find("God Mode (force",1,true) then
    if not m.Active then flyState.godByFly=true; m.Active=true end
    break
  end
end
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if flyState and flyState.timer then flyState.timer.Enabled=false; flyState.timer.destroy(); flyState.timer=nil end
if flyState and flyState.godByFly then
  local al=getAddressList()
  for i=0,al.Count-1 do local m=al.getMemoryRecord(i)
    if (m.Description or ""):find("God Mode (force",1,true) then m.Active=false break end
  end
  flyState.godByFly=false
end
{$asm}
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
