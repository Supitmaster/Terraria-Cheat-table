if p and p~=0 then
  local aID=readInteger(p+0xC8); local aTm=readInteger(p+0xCC)
  if aID and aID~=0 and aTm and aTm~=0 then
    for k=0,43 do if readInteger(aID+8+k*4)==ID then writeInteger(aID+8+k*4,0); writeInteger(aTm+8+k*4,0) end end
  end
end
