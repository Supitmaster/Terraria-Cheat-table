<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Terraria 1.4.5.7 - Made by Supitmaster"</Description>
      <Options moHideChildren="1"/>
      <Color>FF0080</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- self-heal: clear a stale hook left from a previous session
local gl = getAddress("Terraria.Main::get_LocalPlayer")
if gl and gl ~= 0 then
  local b = readBytes(gl+0x10, 1, false)
  if b == 0xE9 then writeBytes(gl+0x10, 0x8B,0x44,0x90,0x08,0xC3) end
end
-- COMPACT MODE: collapse all group headers for tidy navigation
local al = getAddressList()
for i = 0, al.Count-1 do
  local mr = al.getMemoryRecord(i)
  if mr.IsGroupHeader then
  end
end
{$asm}
define(address, Terraria.Main::get_LocalPlayer+10)
define(bytes, 8B 44 90 08 C3)
assert(address, bytes)
alloc(newmem, $1000)
alloc(myPlayer, 4)
label(return)
registersymbol(myPlayer)

newmem:
  mov eax,[eax+edx*4+08]
  mov [myPlayer],eax
  ret

myPlayer:
  dd 0

address:
  jmp newmem
return:

[DISABLE]
address:
  db 8B 44 90 08 C3
unregistersymbol(myPlayer)
dealloc(newmem)
dealloc(myPlayer)
</AssemblerScript>
