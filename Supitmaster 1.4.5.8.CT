            <CheatEntry>
              <ID>10835</ID>
              <Description>"Max Stack Hovered Item (CTRL+F2)"</Description>
              <Color>20C0FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local tt=getAddress('Terraria.Main::MouseText_DrawItemTooltip')
_hoverItemStatic=readInteger(tt+0x54)
if maxStackHotkey then maxStackHotkey.destroy() end
maxStackHotkey=createHotkey(function()
  local ok,mp=pcall(getAddress,'myPlayer'); if not ok or not mp then return end
  local pl=readInteger(mp); if not pl or pl==0 then return end
  local hov=readInteger(_hoverItemStatic); if not hov or hov==0 then return end
  local htype=readInteger(hov+0x50)%65536; if htype==0 then return end
  local hpref=readBytes(hov+0x12E,1,false)
  local hstack=readInteger(hov+0x64)
  -- build container list: inventory(58) + 4 banks(40)
  local conts={}
  local inv=readInteger(pl+0xD4); if inv and inv~=0 then conts[#conts+1]={inv,58} end
  for _,off in ipairs({0xE0,0xE4,0xE8,0xEC}) do
    local ch=readInteger(pl+off); if ch and ch~=0 then local arr=readInteger(ch+0x4); if arr and arr~=0 then conts[#conts+1]={arr,40} end end
  end
  for _,c in ipairs(conts) do
    for i=0,c[2]-1 do
      local it=readInteger(c[1]+8+i*4)
      if it and it~=0 and (readInteger(it+0x50)%65536)==htype and readBytes(it+0x12E,1,false)==hpref and readInteger(it+0x64)==hstack then
        local ms=readInteger(it+0x68); if ms and ms&gt;0 then writeInteger(it+0x64,ms) end return
      end
    end
  end
end, VK_CONTROL, VK_F2)
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if maxStackHotkey then maxStackHotkey.destroy() maxStackHotkey=nil end
{$asm}
