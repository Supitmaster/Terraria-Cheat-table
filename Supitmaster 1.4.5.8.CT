if not buffTimers then buffTimers={} end
if not buffFreeze then buffFreeze={} end
local ID=10
local KEY="b10"
local function pb()
  local ub=getAddress("Terraria.Player::UpdateBuffs")
  if not ub or ub==0 then return nil end
  if readBytes(ub+0xB7,1,false)~=0xA1 then return nil end
  local h=readInteger(ub+0xB8); if not h or h==0 then return nil end
  local a=readInteger(h); if not a or a==0 then return nil end
  return a
end
local function apply()
  local p=readInteger("myPlayer"); if not p or p==0 then return end
  local aID=readInteger(p+0xC8); local aTm=readInteger(p+0xCC)
  if not aID or aID==0 or not aTm or aTm==0 then return end
  local a=pb()
  if a then if buffFreeze[ID]==nil then buffFreeze[ID]=readBytes(a+8+ID,1,false) end writeBytes(a+8+ID,1) end
  local free=-1
  for k=0,43 do local t=readInteger(aID+8+k*4)
    if t==ID then if readInteger(aTm+8+k*4)&lt;1 then writeInteger(aTm+8+k*4,1) end return end
    if free&lt;0 and t==0 then free=k end
  end
  if free&gt;=0 then writeInteger(aID+8+free*4,ID); writeInteger(aTm+8+free*4,1) end
end
local t=createTimer(nil,false); t.Interval=1000; t.OnTimer=apply; t.Enabled=true
buffTimers[KEY]=t
apply()
{$asm}

