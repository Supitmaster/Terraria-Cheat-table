              <Description>"Spawn Rate"</Description>
              <Options moHideChildren="1"/>
              <Color>FF8000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{ Spawn Rate multiplier (ported from TerrariaReGrind). Hooks Spawner::GetSpawnRate epilogue and scales maxSpawns*X (cap 200) and cooldown/X (min 1). Set the child Multiplier: 0=disable spawns, 1=normal, N=Nx. }

[ENABLE]
alloc(spawnMult,4)
registersymbol(spawnMult)
spawnMult:
  dd 1

aobscanregion(SpawnRateAob,Spawner::GetSpawnRate,Spawner::GetSpawnRate+1720,5B 5E 5F 5D C2 08 00)
alloc(SpawnRateCode,$1000,SpawnRateAob)
